# 1. Define Variables
@baseUrl = https://api.luhive.com
@authToken = luh_pt_replace_with_a_key_from_pnpm_create_key
@next_cursor = ""

# 2. Checking the API key
GET {{baseUrl}}/v1/whoami
Authorization: {{authToken}}

###

# 3. Getting all public events
GET {{baseUrl}}/v1/public/events?when=all
Authorization: {{authToken}}

###

# 4. Getting next page of public events
GET {{baseUrl}}/v1/public/events?when=all&cursor={{next_cursor}}
Authorization: {{authToken}}

###

# 5. Getting upcoming public events
GET {{baseUrl}}/v1/public/events?when=ssss
Authorization: {{authToken}}

###

# 6. Getting past public events
GET {{baseUrl}}/v1/public/events?when=past
Authorization: {{authToken}}

###

# 7. Payment callback (what Checkila sends). Needs a community key with the
# payments:confirm scope; use @baseUrl = http://localhost:8787 for local runs.
POST {{baseUrl}}/v1/payments/confirm
x-api-key: {{authToken}}
Content-Type: application/json

{
  "userId": "replace-with-a-registration-uuid",
  "status": "success",
  "amount": 25.0,
  "checkilaRequestId": "replace-with-the-payment-id-stored-on-the-order",
  "transactionId": "epoint-txn-local-1"
}

###
